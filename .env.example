# ==============================================================================
# CineScope Public Deployment Environment Variables Template
# Copy this file to .env for local development or configure in Vercel Project Settings
# ==============================================================================

# 1. The Movie Database (TMDB) API Key
# Client-side environment variable (prefixed with VITE_).
# Sign up at https://www.themoviedb.org/ -> Settings -> API -> Request API Key (Developer)
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# 2. OMDb API Key
# PROTECTED SERVER-SIDE ONLY VARIABLE (NEVER prefixed with VITE_).
# Used exclusively by the /api/omdb serverless function proxy to fetch IMDb ratings.
# Request a free API key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# 3. AI Spoiler-Free Text Generation Provider Key (Optional)
# PROTECTED SERVER-SIDE ONLY VARIABLE (NEVER prefixed with VITE_).
# Used exclusively by the /api/story serverless function proxy.
# If omitted or unavailable, CineScope automatically uses verified TMDB algorithmic synthesis.
# Get a Gemini key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Alternative to Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
